# MongoDB Connection
MONGODB_URI=mongodb://admin:admin123@localhost:27017/vero_finc?authSource=admin

# Application Port
PORT=3000

# URL do frontend (usada para CORS)
FRONTEND_URL=http://localhost:5173

# JWT (troque por um segredo forte em produção)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (service account) — para validar o login com Google
# Copie estes valores do arquivo JSON da service account do Firebase Console.
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
