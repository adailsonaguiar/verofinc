{
  "name": "vero-finc-backend",
  "version": "1.0.0",
  "description": "Financial transactions backend with NestJS and MongoDB",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
